{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company.example/ops-agent/contracts/sqlworkbench/sql-dml-commit-request-v1.schema.json",
  "title": "SQL DML commit request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "query"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "connectionId", "targetEnvironment", "schema", "action", "sql", "parameters", "limits", "idempotencyKey"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "connectionId": { "type": "string", "minLength": 1 },
        "targetEnvironment": { "enum": ["dev", "sit", "uat", "development", "test"] },
        "schema": { "type": "string", "minLength": 1 },
        "action": { "const": "COMMIT_DML" },
        "sql": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "parameters": { "type": "array", "items": { "type": "object" } },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRows", "maxBytes", "timeoutSeconds"],
          "properties": {
            "maxRows": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 100000000 },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
          }
        },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "confirmation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["contractVersion", "sqlHash", "confirmedRisks", "confirmationCode"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "sqlHash": { "type": "string", "minLength": 1 },
        "confirmedRisks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "confirmationCode": { "const": "CONFIRM_SQL_DML_RISK" }
      }
    }
  }
}
